<mxfile host="app.diagrams.net"><diagram name="State machine" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="State machine - Mission lifecycle (P4)" style="text;html=1;align=left;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="800" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="24" height="24" as="geometry"/></mxCell><mxCell id="c4" value="ASSIGNED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="160" height="64" as="geometry"/></mxCell><mxCell id="c5" value="IN_PROGRESS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="160" width="170" height="64" as="geometry"/></mxCell><mxCell id="c6" value="COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="170" height="64" as="geometry"/></mxCell><mxCell id="c7" value="FAILED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="160" height="64" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="30" height="30" as="geometry"/></mxCell><mxCell id="c9" value="submit [every check passes] / consume resources, agents unavailable, mission becomes active" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="submit [another mission active | environment forbids | agent unavailable / lacks capability | resources insufficient] / record reason, never active" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="92" y="432"/></Array></mxGeometry></mxCell><mxCell id="c11" value="time unit passes / start()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="time unit passes [elapsed &amp;gt;= duration] / release agents" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="time unit or external event [equipment failure | storm | comms loss | battery too low | agent unusable | rover breakdown] / fail(reason), release agents" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="330"/><mxPoint x="380" y="330"/></Array></mxGeometry></mxCell><mxCell id="c14" value="external event [failActiveMission(reason) before first tick] / fail(reason), release agents" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="[agents released]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="575"/></Array></mxGeometry></mxCell><mxCell id="c16" value="[no retry: new mission object needed]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="575"/></Array></mxGeometry></mxCell><mxCell id="c17" value="" style="html=1;endArrow=open;endFill=0;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725" y="160" as="sourcePoint"/><mxPoint x="725" y="160" as="targetPoint"/><Array as="points"><mxPoint x="780" y="110"/><mxPoint x="680" y="110"/></Array></mxGeometry></mxCell><mxCell id="c18" value="time unit passes [elapsed &amp;lt; duration] / advance()" style="text;html=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="575" y="82" width="300" height="20" as="geometry"/></mxCell><mxCell id="c19" value="Notes: COMPLETED and FAILED have no outgoing transitions except to the final state. &amp;#x27;Not yet submitted&amp;#x27; is the initial pseudo-state, not a fifth state." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="800" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>